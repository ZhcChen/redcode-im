# 生产环境配置文件
# ======================

# 数据库配置
DATABASE_URL=postgresql://postgres:password@postgres:5432/redcode_im

# Redis 多实例配置
REDIS_SESSION_URL=redis://redis-session:6381
REDIS_STREAM_URL=redis://redis-streams:6382
REDIS_CACHE_URL=redis://redis-cache:6383

# 服务器配置
PORT=8080
HOST=0.0.0.0

# JWT 配置
JWT_SECRET=redcode-im-super-secret-jwt-key-change-this-in-production

# 日志级别
RUST_LOG=info

# 时区
TZ=Asia/Shanghai

# 性能配置
MAX_CONNECTIONS=20
REDIS_POOL_SIZE=10

# WebSocket配置
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=10000

# 消息配置
MESSAGE_MAX_SIZE=10240
MESSAGE_HISTORY_LIMIT=1000

# 会话配置
SESSION_TIMEOUT=86400
NODE_HEARTBEAT_INTERVAL=30