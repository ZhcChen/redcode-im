# im-test-1 测试环境
# POSTGRES_PASSWORD / REDIS_PASSWORD 请使用 URL-safe 字符，
# 因为 compose 会基于它们直接拼接 DATABASE_URL / REDIS URL。

TZ=Asia/Shanghai

API_IMAGE=redcode-im-api:im-test-1
# 通过 Caddy 暴露时仅监听本机回环地址。
API_BIND_IP=127.0.0.1
API_PORT=8010

ADMIN_IMAGE=redcode-im-admin:im-test-1
ADMIN_BIND_IP=127.0.0.1
ADMIN_PORT=8011

RUST_LOG=info

POSTGRES_DB=redcode_im
POSTGRES_USER=redcode
POSTGRES_PASSWORD=replace-with-32-char-url-safe-password
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=4
DATABASE_ACQUIRE_TIMEOUT_SECONDS=30

REDIS_PASSWORD=replace-with-32-char-url-safe-password
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=volatile-lru

JWT_SECRET=replace-with-64-char-url-safe-secret
DATA_ENCRYPTION_KEY=replace-with-64-char-url-safe-secret

WS_OUTBOUND_QUEUE_SIZE=2048
METRICS_ENABLED=true
METRICS_CHANNEL_CAPACITY=65536
METRICS_FLUSH_BATCH_SIZE=5000
METRICS_FLUSH_INTERVAL_SECONDS=5
METRICS_SAMPLE_RATE=1.0
