# =================================
# RedCode IM 环境配置示例
# =================================
# 复制此文件为 .env 并填入实际值

# ----------------------------
# 服务器配置
# ----------------------------
PORT=8010

# ----------------------------
# 数据库配置
# ----------------------------
DATABASE_URL=postgresql://redcode_user:strong_password@localhost:5432/redcode_im

# ----------------------------
# Redis 配置
# ----------------------------
# 会话管理 Redis（用于用户会话、节点心跳等）
REDIS_SESSION_URL=redis://:password@localhost:6381/0
# 缓存 Redis（用于数据缓存）
REDIS_CACHE_URL=redis://:password@localhost:6383/0

# ----------------------------
# JWT 认证配置
# ----------------------------
# JWT 密钥（生产环境请使用强密钥）
JWT_SECRET=your-256-bit-secret-key-here

# ----------------------------
# 日志配置
# ----------------------------
# 日志级别: trace, debug, info, warn, error
RUST_LOG=info

# ----------------------------
# 文件上传清理任务配置（可选）
# ----------------------------
# 清理任务执行间隔（秒），默认 3600（1小时）
# FILE_UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
# pending 记录超时阈值（秒），默认 21600（6小时）
# FILE_UPLOAD_PENDING_TIMEOUT_SECONDS=21600
# 孤立文件删除阈值（秒），默认 604800（7天）
# FILE_UPLOAD_ORPHAN_DELETE_AFTER_SECONDS=604800
# 未引用文件保留时间（秒），默认 2592000（30天）
# FILE_UPLOAD_UNREFERENCED_RETENTION_SECONDS=2592000
# 单次清理批处理条数，默认 200
# FILE_UPLOAD_CLEANUP_BATCH_SIZE=200

# ----------------------------
# 数据库日志存储配置（可选）
# ----------------------------
# 是否启用数据库日志存储（默认 true）
# LOG_DB_ENABLED=true
# 存储的日志级别，逗号分隔（默认 debug,warn,error）
# LOG_DB_LEVELS=debug,warn,error
# 日志保留天数（默认 7 天）
# LOG_DB_RETENTION_DAYS=7
# 批量写入大小（默认 100）
# LOG_DB_BATCH_SIZE=100
# 刷新间隔（毫秒，默认 5000）
# LOG_DB_FLUSH_INTERVAL_MS=5000

# ----------------------------
# 开发环境配置（可选）
# ----------------------------
# 允许不安全的管理员引导（仅开发环境使用！）
# ALLOW_INSECURE_ADMIN_BOOTSTRAP=true
