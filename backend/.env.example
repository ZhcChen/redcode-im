# =================================
# RedCode IM 环境配置示例
# =================================
# 复制此文件为 .env 并填入实际值

# ----------------------------
# 服务器配置
# ----------------------------
PORT=8010
NODE_ENV=production
API_VERSION=v1

# ----------------------------
# 数据库配置
# ----------------------------
DATABASE_URL=postgresql://redcode_user:strong_password@localhost:5432/redcode_im
# 或使用独立配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=redcode_im
DB_USER=redcode_user
DB_PASSWORD=strong_password
DB_SSL_MODE=require

# ----------------------------
# Redis 配置
# ----------------------------
REDIS_URL=redis://:strong_redis_password@localhost:6379/0
# 或使用独立配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=strong_redis_password
REDIS_DB=0
REDIS_SSL=false

# Redis 实例（多用途）
REDIS_SESSION_URL=redis://:password@localhost:6381/0
REDIS_STREAM_URL=redis://:password@localhost:6382/0
REDIS_CACHE_URL=redis://:password@localhost:6383/0

# ----------------------------
# JWT 认证配置
# ----------------------------
# JWT 密钥（生产环境请使用密钥管理服务）
JWT_SECRET=your-256-bit-secret-key-here
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# Token 过期时间（秒）
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=604800
# 发行者
JWT_ISSUER=redcode-im
# 受众
JWT_AUDIENCE=redcode-im-client

# ----------------------------
# 文件存储配置
# ----------------------------
# 存储提供商: local, s3, oss
STORAGE_PROVIDER=local
# 本地存储路径
STORAGE_LOCAL_PATH=./storage
# S3 配置
S3_BUCKET_NAME=redcode-im-files
S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_ENDPOINT=https://s3.amazonaws.com
# 文件大小限制（字节）
MAX_FILE_SIZE=10485760
# 允许的文件类型
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain

# ----------------------------
# 安全配置
# ----------------------------
# API 密钥加密
API_KEY_ENCRYPTION_KEY=32-byte-encryption-key-here
# 密码哈希配置
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_PARALLELISM=4
# 速率限制
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
# IP 黑名单（用逗号分隔）
IP_BLACKLIST=
# IP 白名单（用逗号分隔）
IP_WHITELIST=

# ----------------------------
# CORS 配置
# ----------------------------
# 允许的来源（用逗号分隔）
CORS_ALLOWED_ORIGINS=https://redcode-im.com,https://www.redcode-im.com
# 允许的方法
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
# 允许的请求头
CORS_ALLOWED_HEADERS=content-type,authorization,accept,x-requested-with,x-api-key
# 是否允许凭证
CORS_ALLOW_CREDENTIALS=true
# 预检缓存时间（秒）
CORS_MAX_AGE=3600

# ----------------------------
# 日志配置
# ----------------------------
# 日志级别: trace, debug, info, warn, error
RUST_LOG=info
LOG_LEVEL=info
# 日志文件路径
LOG_FILE=./logs/app.log
# 是否启用 JSON 格式日志
LOG_JSON_FORMAT=false
# 是否记录请求体（注意：可能包含敏感信息）
LOG_REQUEST_BODY=false
# 是否记录响应体（注意：可能包含敏感信息）
LOG_RESPONSE_BODY=false

# ----------------------------
# 监控配置
# ----------------------------
# 是否启用 Prometheus 指标
METRICS_ENABLED=true
METRICS_PORT=9090
# 是否启用健康检查
HEALTH_CHECK_ENABLED=true
# 健康检查端口
HEALTH_CHECK_PORT=8011

# ----------------------------
# 业务配置
# ----------------------------
# 单个群组最大成员数
GROUP_MAX_MEMBERS=500
# 单个用户最大加入群组数
USER_MAX_GROUPS=100
# 消息最大长度
MESSAGE_MAX_LENGTH=4000
# 消息历史保留天数
MESSAGE_HISTORY_DAYS=365
# 用户名验证规则
USERNAME_MIN_LENGTH=3
USERNAME_MAX_LENGTH=20
# 密码验证规则
PASSWORD_MIN_LENGTH=6
PASSWORD_MAX_LENGTH=128

# ----------------------------
# 开发环境特定配置
# ----------------------------
# 开发模式下才使用
DEV_AUTO_MIGRATE=true
DEV_SEED_DATA=false
# 调试模式（生产环境必须设为 false）
DEBUG=false
# 详细错误信息
VERBOSE_ERRORS=false
