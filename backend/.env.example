### Backend service environment configuration (example values)

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/redcode_im

# Redis instances for session, stream, and cache
REDIS_SESSION_URL=redis://localhost:6381/0
REDIS_STREAM_URL=redis://localhost:6382/0
REDIS_CACHE_URL=redis://localhost:6383/0

# JWT secret used for signing tokens
JWT_SECRET=change-me

# HTTP server port and logging level
PORT=8010
RUST_LOG=info
