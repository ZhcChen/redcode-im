# =================================
# RedCode IM 环境配置示例
# =================================
# 用法：
#   cp .env.example .env
#   然后按需修改

# ----------------------------
# 服务器配置
# ----------------------------
PORT=8010

# ----------------------------
# 日志配置
# ----------------------------
# 日志级别: trace, debug, info, warn, error
RUST_LOG=debug

# ----------------------------
# 数据库配置
# ----------------------------
# 本项目启动时会读取 DATABASE_URL（必填）
# - 若使用 backend/docker-compose.yml 启动 postgres，默认账号/密码/库名如下：
#   POSTGRES_USER=postgres POSTGRES_PASSWORD=123456 POSTGRES_DB=redcode_im
DATABASE_URL=postgres://postgres:123456@localhost:5432/redcode_im

# 可选：用于 cargo test 等场景（若未设置会回退到 DATABASE_URL）
# DATABASE_URL_TEST=postgres://postgres:123456@localhost:5432/redcode_test

# ----------------------------
# Redis 配置
# ----------------------------
# 会话管理 Redis（用于用户会话、节点心跳等）
REDIS_SESSION_URL=redis://:123456@localhost:6381/0
# 缓存 Redis（用于数据缓存）
REDIS_CACHE_URL=redis://:123456@localhost:6383/0

# ----------------------------
# JWT 认证配置
# ----------------------------
# JWT 密钥（生产环境请使用强随机值）
JWT_SECRET=dev-secret-change-me

# ----------------------------
# 文件上传清理任务配置（可选）
# ----------------------------
# 清理任务执行间隔（秒），默认 3600（1小时）
# FILE_UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
# pending 记录超时阈值（秒），默认 21600（6小时）
# FILE_UPLOAD_PENDING_TIMEOUT_SECONDS=21600
# 孤立文件删除阈值（秒），默认 604800（7天）
# FILE_UPLOAD_ORPHAN_DELETE_AFTER_SECONDS=604800
# 未引用文件保留时间（秒），默认 2592000（30天）
# FILE_UPLOAD_UNREFERENCED_RETENTION_SECONDS=2592000
# 单次清理批处理条数，默认 200
# FILE_UPLOAD_CLEANUP_BATCH_SIZE=200

# ----------------------------
# 数据库日志存储配置（可选）
# ----------------------------
# 是否启用数据库日志存储（默认 true）
# LOG_DB_ENABLED=true
# 存储的日志级别，逗号分隔（默认 debug,warn,error）
# LOG_DB_LEVELS=debug,warn,error
# 日志保留天数（默认 7 天）
# LOG_DB_RETENTION_DAYS=7
# 批量写入大小（默认 100）
# LOG_DB_BATCH_SIZE=100
# 刷新间隔（毫秒，默认 5000）
# LOG_DB_FLUSH_INTERVAL_MS=5000
# 是否启用控制台日志输出（默认 true，生产环境可设置为 false 以提升性能）
# LOG_CONSOLE_ENABLED=true

# ----------------------------
# 开发环境配置（可选）
# ----------------------------
# 允许不安全的管理员引导（仅开发环境使用！）
# ALLOW_INSECURE_ADMIN_BOOTSTRAP=true

# ----------------------------
# Push 通知配置（可选）
# ----------------------------
# 是否启用 Push（默认 true；推荐在管理后台配置 push_enabled / push_skip_if_online）
# PUSH_ENABLED=true
# 若用户当前已建立 WebSocket 连接，是否跳过 Push（默认 true）
# PUSH_SKIP_IF_ONLINE=true

# FCM/OAuth 请求超时（秒，默认 10）
# PUSH_HTTP_TIMEOUT_SECONDS=10
# 全局并发上限（限制同时进行的 FCM 请求数，默认 50）
# PUSH_SEND_CONCURRENCY=50
# 单个事件内对多个设备发送的并发度（默认 20）
# PUSH_DEVICE_SEND_CONCURRENCY=20

# Push job 队列（DB 主队列：所有 push job 落库后由后台 worker 认领并发送）
# 是否启用（默认 true）
# PUSH_DB_QUEUE_ENABLED=true
# worker 并发度（默认 20）
# PUSH_DB_QUEUE_CONCURRENCY=20
# （兼容旧配置名）PUSH_JOB_CONCURRENCY=20
# 每轮认领任务数（默认 200）
# PUSH_DB_QUEUE_BATCH_SIZE=200
# 认领租约（秒，默认 120；用于多节点避免重复处理）
# PUSH_DB_QUEUE_LEASE_SECONDS=120
# 轮询间隔（秒，默认 2）
# PUSH_DB_QUEUE_POLL_INTERVAL_SECONDS=2
# 最大重试次数（默认 12）
# PUSH_DB_QUEUE_MAX_ATTEMPTS=12
# 重试退避基准（秒，默认 2）
# PUSH_DB_QUEUE_RETRY_BASE_SECONDS=2
# 重试退避最大值（秒，默认 300）
# PUSH_DB_QUEUE_RETRY_MAX_SECONDS=300

# push_job_queue 自动清理（多节点部署通过 DB advisory lock 保证同一时间仅一台执行）
# 是否启用（默认 true）
# PUSH_DB_QUEUE_CLEANUP_ENABLED=true
# 保留天数（默认 7，仅清理 done/failed）
# PUSH_DB_QUEUE_RETENTION_DAYS=7
# 清理间隔（秒，默认 86400）
# PUSH_DB_QUEUE_CLEANUP_INTERVAL_SECONDS=86400
# 每批清理数量（默认 10000）
# PUSH_DB_QUEUE_CLEANUP_BATCH_SIZE=10000
# 单次最多执行批次数（默认 20）
# PUSH_DB_QUEUE_CLEANUP_MAX_BATCHES=20

# 用于加密存储 Push 平台敏感配置（管理后台录入的 service account / 私钥等）
# - 推荐生产环境设置为强随机值（不低于 32 字符）
# - 若未设置，将回退使用 JWT_SECRET 派生密钥（仅建议开发环境）
# DATA_ENCRYPTION_KEY=your-strong-random-key
