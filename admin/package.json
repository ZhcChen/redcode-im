{
  "name": "arco-design-pro-vue",
  "description": "Arco Design Pro for Vue",
  "version": "1.0.0",
  "private": true,
  "author": "ArcoDesign Team",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --config ./config/vite.config.dev.ts",
    "build": "vite build --config ./config/vite.config.prod.ts",
    "build:check": "vue-tsc --noEmit && vite build --config ./config/vite.config.prod.ts",
    "report": "cross-env REPORT=true bun run build",
    "preview": "bun run build && vite preview --host",
    "type:check": "vue-tsc --noEmit --skipLibCheck",
    "test:e2e:install": "playwright install",
    "test:e2e": "playwright test",
    "test:e2e:live": "ADMIN_E2E_ENABLED=true ADMIN_LIVE_BACKEND_ENABLED=true playwright test playwright-tests/specs/live-backend-smoke.spec.ts",
    "test:e2e:live:data-cleanup": "ADMIN_E2E_ENABLED=true ADMIN_LIVE_BACKEND_ENABLED=true playwright test playwright-tests/specs/live-backend-data-cleanup.spec.ts",
    "test:e2e:live:rbac": "ADMIN_E2E_ENABLED=true ADMIN_LIVE_BACKEND_ENABLED=true playwright test playwright-tests/specs/live-backend-rbac-management.spec.ts",
    "test:e2e:routes": "playwright test playwright-tests/specs/route-smoke.spec.ts",
    "test:e2e:routes:default": "ADMIN_ROUTE_PROFILE=default playwright test playwright-tests/specs/route-smoke.spec.ts",
    "test:e2e:routes:data-cleanup": "ADMIN_ROUTE_PROFILE=data-cleanup playwright test playwright-tests/specs/route-smoke.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint-staged": "bunx lint-staged",
    "prepare": "cd .. && husky install admin/.husky"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "stylelint --fix",
      "prettier --write",
      "eslint --fix"
    ],
    "*.{less,css}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.58.0",
    "@playwright/test": "^1.62.1",
    "@vueuse/core": "^9.13.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "lodash": "^4.18.1",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.1",
    "query-string": "^8.2.0",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.41",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@arco-plugins/vite-vue": "^1.4.6",
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@types/node": "^24.13.3",
    "@types/lodash": "^4.17.25",
    "@types/minimatch": "^6.0.0",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/babel-plugin-jsx": "^1.5.0",
    "consola": "^2.15.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^8.0.3",
    "less": "^4.8.1",
    "lint-staged": "^17.3.0",
    "postcss-html": "^1.8.1",
    "prettier": "^2.8.8",
    "rollup": "^3.30.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "stylelint": "^14.16.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^28.0.0",
    "stylelint-order": "^5.0.0",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^0.24.1",
    "vite": "^7.3.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-svg-loader": "^3.6.0",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
