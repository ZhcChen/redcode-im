# 生产环境配置
# API 基础 URL - 生产服务器
# 请根据实际部署情况修改为您的生产环境 API 地址
VITE_API_BASE_URL=https://api.chatlyme.com

# 环境标识
VITE_ENV=production

# 启用 Rust 后端 (生产环境推荐启用以获得更好的性能)
VITE_USE_RUST_BACKEND=true

# 功能开关 - 生产环境全部启用 Rust
VITE_RUST_USER_API=true
VITE_RUST_SYSTEM_API=true
VITE_RUST_FILE_UPLOAD=true
VITE_RUST_MESSAGES=true
VITE_RUST_FRIENDS=true
VITE_RUST_GROUPS=true
VITE_RUST_SEARCH=true
VITE_RUST_ACCOUNT=true
VITE_RUST_CHATGPT=true
VITE_RUST_FRIEND_CIRCLE=true
VITE_RUST_MUSIC=true
VITE_RUST_VERSION=true

# 高级功能开关
VITE_RUST_BATCH_REQUESTS=true
VITE_RUST_CONNECTION_POOL=true
VITE_RUST_FILE_DOWNLOAD=true
VITE_RUST_PROXY=false
VITE_RUST_SSL_VERIFY=true

# 性能配置
VITE_HTTP_TIMEOUT=60000
VITE_HTTP_MAX_RETRIES=3
VITE_HTTP_RETRY_DELAY=2000

# 批量请求配置
VITE_BATCH_SIZE=20
VITE_BATCH_CONCURRENCY=10

# 文件上传配置
VITE_MAX_FILE_SIZE=52428800  # 50MB
VITE_UPLOAD_CHUNK_SIZE=2097152  # 2MB
VITE_UPLOAD_CONCURRENCY=5

# 缓存配置
VITE_ENABLE_CACHE=true
VITE_CACHE_TTL=600
VITE_CACHE_MAX_SIZE=2000

# 调试配置 - 生产环境关闭
VITE_ENABLE_DEBUG_LOG=false
VITE_ENABLE_PERFORMANCE_MONITOR=false
VITE_ENABLE_MEMORY_PROFILING=false

# 生产环境特定配置
VITE_ENABLE_HOT_RELOAD=false
VITE_ENABLE_SOURCE_MAPS=false
VITE_ENABLE_DEV_TOOLS=false
VITE_ENABLE_ERROR_REPORTING=true
VITE_SENTRY_DSN=