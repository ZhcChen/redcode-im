# Rust HTTP 客户端配置
# 启用 Rust 后端 (true/false)
VITE_USE_RUST_BACKEND=false

# API 基础 URL
VITE_API_BASE_URL=http://localhost:8080

# 功能开关 - 各个模块是否使用 Rust
VITE_RUST_USER_API=false
VITE_RUST_SYSTEM_API=false
VITE_RUST_FILE_UPLOAD=true
VITE_RUST_MESSAGES=false
VITE_RUST_FRIENDS=false
VITE_RUST_GROUPS=false
VITE_RUST_SEARCH=false
VITE_RUST_ACCOUNT=false
VITE_RUST_CHATGPT=false
VITE_RUST_FRIEND_CIRCLE=false
VITE_RUST_MUSIC=false
VITE_RUST_VERSION=false

# 高级功能开关
VITE_RUST_BATCH_REQUESTS=true
VITE_RUST_CONNECTION_POOL=true
VITE_RUST_FILE_DOWNLOAD=true
VITE_RUST_PROXY=false
VITE_RUST_SSL_VERIFY=true

# 性能配置
VITE_HTTP_TIMEOUT=30000
VITE_HTTP_MAX_RETRIES=3
VITE_HTTP_RETRY_DELAY=1000

# 批量请求配置
VITE_BATCH_SIZE=10
VITE_BATCH_CONCURRENCY=5

# 文件上传配置
VITE_MAX_FILE_SIZE=10485760
VITE_UPLOAD_CHUNK_SIZE=1048576
VITE_UPLOAD_CONCURRENCY=3

# 缓存配置
VITE_ENABLE_CACHE=true
VITE_CACHE_TTL=300
VITE_CACHE_MAX_SIZE=1000

# 调试配置
VITE_ENABLE_DEBUG_LOG=false
VITE_ENABLE_PERFORMANCE_MONITOR=true
VITE_ENABLE_MEMORY_PROFILING=false
