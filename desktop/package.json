{
  "name": "redcode-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "tauri": "bash -c 'export TMPDIR=$HOME/.cargo-tmp && tauri \"$@\"' --",
    "tauri:dev": "./run_dev.sh",
    "test": "uv run python -m pytest",
    "test:ci": "CI=1 uv run python -m pytest --maxfail=1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/runtime-core": "^3.5.21",
    "@vue/tsconfig": "^0.8.1",
    "sass-embedded": "^1.92.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
