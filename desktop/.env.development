# 开发环境配置
# API 基础 URL - 本地开发服务器
VITE_API_BASE_URL=http://localhost:8010

# 环境标识
VITE_ENV=development

# 启用 Rust 后端 (开发环境可以选择性启用)
VITE_USE_RUST_BACKEND=false

# 功能开关 - 开发环境
VITE_RUST_USER_API=false
VITE_RUST_SYSTEM_API=false
VITE_RUST_FILE_UPLOAD=false
VITE_RUST_MESSAGES=false
VITE_RUST_FRIENDS=false
VITE_RUST_GROUPS=false
VITE_RUST_SEARCH=false
VITE_RUST_ACCOUNT=false
VITE_RUST_CHATGPT=false
VITE_RUST_FRIEND_CIRCLE=false
VITE_RUST_MUSIC=false
VITE_RUST_VERSION=false

# 高级功能开关
VITE_RUST_BATCH_REQUESTS=false
VITE_RUST_CONNECTION_POOL=false
VITE_RUST_FILE_DOWNLOAD=false
VITE_RUST_PROXY=false
VITE_RUST_SSL_VERIFY=false

# 性能配置
VITE_HTTP_TIMEOUT=30000
VITE_HTTP_MAX_RETRIES=3
VITE_HTTP_RETRY_DELAY=1000

# 调试配置 - 开发环境启用
VITE_ENABLE_DEBUG_LOG=true
VITE_ENABLE_PERFORMANCE_MONITOR=true
VITE_ENABLE_MEMORY_PROFILING=true

# 开发环境特定配置
VITE_ENABLE_HOT_RELOAD=true
VITE_ENABLE_SOURCE_MAPS=true
VITE_ENABLE_DEV_TOOLS=true