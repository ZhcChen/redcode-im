# Flutter 环境配置文件
# 复制此文件为 .env 并修改配置值
# 脚本会自动读取 .env 文件中的配置

# 环境类型: development / staging / production
ENV=development

# API 地址（留空则使用环境默认值）
API_BASE_URL=http://10.137.203.83:8010
WS_URL=ws://10.137.203.83:8010/ws

# 调试配置
ENABLE_DEBUG_LOG=true
ENABLE_PERFORMANCE_MONITOR=false

# Mock 数据
USE_MOCK_DATA=false
