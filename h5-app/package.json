{
  "name": "redcode-im-h5-app",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8016",
    "e2ee:build": "wasm-pack build ../e2ee-core --target web --release --out-dir ../h5-app/src/e2ee/core-wasm",
    "build": "bun run e2ee:build && vue-tsc --noEmit && vite build",
    "release:finalize": "bun ../scripts/h5-release-security.ts finalize dist",
    "release:check": "bun ../scripts/h5-release-security.ts check dist",
    "release:http-check": "bun ../scripts/h5-release-http-check.ts dist",
    "release:serve": "bun ../scripts/h5-release-server.ts dist",
    "release:test": "bun ../tests/scripts/test-h5-release-security.ts && bun ../tests/scripts/test-h5-release-browser-audit.ts",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 8016",
    "test": "VITE_USE_MOCK_DATA=true vitest run",
    "test:watch": "VITE_USE_MOCK_DATA=true vitest",
    "test:live": "H5_APP_LIVE_BACKEND_ENABLED=true vitest run test/live-backend-smoke.test.ts test/live-service-smoke.test.ts test/ios-h5-chat-interop-smoke.test.ts",
    "test:e2ee:live": "H5_APP_E2EE_LIVE_ENABLED=true vitest run test/e2ee-live-backend.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "wa-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "ws": "^8.21.2"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "undici": "7.29.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "bun": ">=1.3.0"
  }
}
