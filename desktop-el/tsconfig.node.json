{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node"],
    "outDir": "dist/electron"
  },
  "include": ["vite.config.ts", "electron/main/**/*.ts", "electron/preload/**/*.ts"]
}
